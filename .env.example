# Copia este archivo como .env y llena los valores. .env nunca se sube a git.

# Firma la cookie de sesión (carrito). Cualquier texto largo y aleatorio.
SESSION_SECRET=

# Formulario de contacto (https://resend.com). Solo se usa en el servidor.
RESEND_API_KEY=
CONTACT_EMAIL=

# Opcional: número de WhatsApp con indicativo de país, solo dígitos.
# Si está vacío no se muestra el botón de WhatsApp.
PUBLIC_WHATSAPP_NUMBER=
